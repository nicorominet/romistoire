# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=imagitales
DB_PORT=3306

# Server Configuration
API_PORT=3001
NODE_ENV=development
# The API has no login: this machine only by default (0.0.0.0 = whole network, trusted network only)
API_HOST=127.0.0.1
# Browser origins allowed to call the API (default: the Vite dev server)
# ALLOWED_ORIGINS=http://localhost:8885,http://127.0.0.1:8885

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model fallback order, timeouts (Settings > AI overrides them)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash
# GEMINI_AUDIO_MODELS=gemini-2.5-flash-preview-tts
# GEMINI_TIMEOUT_MS=120000
# GEMINI_WEEK_TIMEOUT_MS=240000

# Local AI (optional)
# AI_PROVIDER=gemini            # default provider: gemini | local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_TIMEOUT_MS=600000
