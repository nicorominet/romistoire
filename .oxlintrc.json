{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "public/tools",
    "coverage"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "warn",
    "no-console": "off",
    "vitest/require-mock-type-parameters": "off",
    "react/set-state-in-effect": "warn",
    "react/immutability": "warn",
    "react/static-components": "warn",
    "react/purity": "warn",
    "react/incompatible-library": "warn",
    "react/refs": "warn"
  }
}
